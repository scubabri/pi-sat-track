node -e '
const net = require("net");
const host = "172.17.18.178";
const port = 4535;
const s = net.connect({ host, port, family: 4 }, () => {
  console.log("connected");
  s.write("p\n");
});
s.setEncoding("utf8");
s.on("data", (d) => { console.log("data:", JSON.stringify(d)); s.end(); });
s.on("error", (e) => console.error("error:", e.message));
setTimeout(() => {}, 3000);
'
